# Copy to .env.local for local development. All three are optional.

# Anonymous usage counters (Supabase table playground_stats). Leave unset
# locally so development never posts events to production.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AdSense publisher id. Read by vite.config.ts (index.html) and AdBanner.tsx;
# defaults to the production id when unset.
# VITE_ADSENSE_PUB_ID=ca-pub-your-publisher-id
